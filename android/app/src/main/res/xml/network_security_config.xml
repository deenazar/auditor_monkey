<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP is blocked everywhere except the phone's own loopback
     address. The 3D mascot (flutter_3d_controller) serves assets/3d/monkey.glb
     to its WebView from a local server on 127.0.0.1; nothing leaves the
     phone. See docs/DECISIONS.md (2026-11-13, mascot loopback). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
